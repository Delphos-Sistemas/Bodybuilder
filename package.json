{
  "name": "bodybuilder",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/generate-sw.mjs",
    "start": "node scripts/serve-out.mjs --port 3000",
    "preview": "node scripts/serve-out.mjs --port 4173 --host",
    "lint": "eslint src tests scripts worker",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "media": "node scripts/build-media.mjs",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "3.1.0",
    "zod": "4.0.5",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.0.14",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "eslint": "9.31.0",
    "eslint-config-next": "15.5.29",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "wrangler": "4.45.0"
  }
}
